---
layout: null
---

[
  {% for p in site.projects %}
    {
      "title": {{ p.title | jsonify }},
      {% if p.description %}"description": {{ p.description | jsonify }},{% endif %}
      {% if p.image %}"image": {{ p.image | jsonify }},{% endif %}
      {% if p.video %}"video": {{ p.video | jsonify }},{% endif %}
      {% if p.skills %}"skills": {{ p.skills | jsonify }},{% endif %}
      {% if p.github %}"github": {{ p.github | jsonify }},{% endif %}
      {% if p.demo %}"demo": {{ p.demo | jsonify }},{% endif %}
      {% if p.content %}"content": {{ p.content | markdownify | strip_newlines | jsonify }},{% endif %}
      {% if p.category %}"category": {{ p.category | jsonify }}{% endif %}
    }
    {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
